# Copiar a .env (no se commitea). Ninguna variable es obligatoria para correr en local.

# Proveedor de LLM: scripted (default, determinístico) | ollama | openai | anthropic
LLM_PROVIDER=scripted
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Opcionales y apagados: solo si el cliente provee su clave.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# WhatsApp Cloud API. En local se usan valores de desarrollo públicos (ver src/config.ts).
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
WHATSAPP_MODE=mock

# Persistencia: ruta del SQLite o "memory".
DB_PATH=data/app.db
PORT=8790

# Protege /api/* con Bearer token (en producción, además, Cloudflare Access).
# DASHBOARD_TOKEN=

# Webhook post-conversación (por ejemplo, el workflow de n8n en n8n/).
# POST_CONVERSATION_WEBHOOK_URL=http://127.0.0.1:5679/webhook/post-conversation

# Adaptador real de CRM (solo si el playbook usa crm.adapter: hubspot).
# HUBSPOT_TOKEN=
